# ============================================================================
#  Controle VPS - Central de Monitoramento CyberPanel
#  Copie este arquivo para ".env" e ajuste os valores.
#  NUNCA versione o arquivo .env real.
# ============================================================================

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
APP_NAME="Controle VPS"
APP_ENV=local
APP_DEBUG=true

# URL base publica da aplicacao (sem barra no final).
# Vhost Laragon .......: http://controle-vps.test
# Sem vhost ...........: http://localhost/controle-vps/public
# Producao ............: https://monitoramento.seudominio.com.br
APP_URL=http://controle-vps.test

# Chave de 32 bytes em base64 usada para assinaturas internas.
# Gere uma nova com:  php bin/console.php key:generate
APP_KEY=

# Fuso horario usado em toda a aplicacao.
APP_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=controle-vps
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# Sessao
# ---------------------------------------------------------------------------
SESSION_NAME=controle_vps_session
SESSION_LIFETIME=120
# Em producao com HTTPS: true
SESSION_SECURE=false

# ---------------------------------------------------------------------------
# Seguranca
# ---------------------------------------------------------------------------
# Tentativas de login antes do bloqueio temporario
LOGIN_MAX_ATTEMPTS=5
# Janela / bloqueio em minutos
LOGIN_DECAY_MINUTES=15

# Rate limiting da API de agentes (requisicoes por janela, por servidor)
API_RATE_LIMIT=120
API_RATE_WINDOW=60

# Tolerancia (segundos) entre o timestamp assinado pelo agente e o servidor
AGENT_CLOCK_SKEW=300

# ---------------------------------------------------------------------------
# Monitoramento
# ---------------------------------------------------------------------------
# Intervalo esperado de coleta do agente, em segundos (padrao 5 minutos)
AGENT_INTERVAL=300
# Sem heartbeat por este tempo (segundos) => servidor marcado OFFLINE
SERVER_OFFLINE_AFTER=600
# Retencao das metricas detalhadas, em dias
METRICS_RETENTION_DAYS=30
# Retencao do historico de checagens de site, em dias
SITE_CHECKS_RETENTION_DAYS=30
# Retencao dos logs de auditoria, em dias (0 = nunca apagar)
AUDIT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=debug
LOG_MAX_FILES=14
